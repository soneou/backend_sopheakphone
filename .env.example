# Flask
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-different-random-string

# Aiven MySQL connection string, format:
# mysql://user:password@host:port/dbname
DATABASE_URL=mysql://avnadmin:password@your-service.aivencloud.com:12345/defaultdb

# Single admin account for the /admin panel
ADMIN_USERNAME=admin
# Generate with: python scripts/hash_password.py "your-chosen-password"
ADMIN_PASSWORD_HASH=

# Cloudinary (free tier) - https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of allowed frontend origins (your Vercel URL(s))
FRONTEND_ORIGINS=http://localhost:5173,https://your-app.vercel.app
